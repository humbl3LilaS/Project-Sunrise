{
  "compilerOptions": {
    "target": "ES2022", // Modern JS output
    "lib": ["ES2022", "DOM"], // Include ES2022 and DOM APIs
    "baseUrl": ".", // Base for path aliases
    "module": "ESNext", // Keep native ESM modules
    "moduleResolution": "node", // Resolve Node-style imports
    "paths": {
      // Project-wide aliases
      "@utils/*": ["src/utils/*"],
      "@db/*": ["src/db/*"],
      "@middlewares/*": ["src/middlewares/*"],
      "@routes/*": ["src/routes/*"],
      "@doc/*": ["src/doc/*"],
      "@actions/*": ["src/actions/*"],
      "@valid/*": ["src/validators/*"],
      "@const/*": ["src/constants/*"],
      "@/*": ["src/*"]
    },
    "resolveJsonModule": true, // Allow importing JSON files
    "strict": true, // Enable all strict type checks
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "dist", // Output folder
    "sourceMap": true, // Optional, for debugging
    "allowSyntheticDefaultImports": true, // Makes default imports easier
    "esModuleInterop": true, // For compatibility with commonjs imports
    "forceConsistentCasingInFileNames": true, // Prevent casing issues
    "skipLibCheck": true // Skip type check of node_modules
  },
  "include": ["src", "types"], // Include source and shared types
  "exclude": ["node_modules", "dist"] // Exclude build output
}
